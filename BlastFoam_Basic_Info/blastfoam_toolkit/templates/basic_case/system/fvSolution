FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}

// =============================================================================
// BlastFOAM Basic Case Template - fvSolution
// הגדרות פותרים לינאריים
// =============================================================================

solvers
{
    // משוואות היפרבוליות - נפתרות במפורש
    "(rho|rhoU|rhoE|alpha.*)"
    {
        solver          diagonal;
    }

    // משוואות אליפטיות/פרבוליות
    "(U|e)"
    {
        solver          PBiCGStab;
        preconditioner  DIC;
        tolerance       1e-12;
        relTol          0;
        minIter         1;
    }
    
    // לחץ (אם נדרש)
    p
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-10;
        relTol          0.01;
    }
    
    // טמפרטורה
    T
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-12;
        relTol          0;
    }
}

// =============================================================================
// הגדרות PIMPLE (אם נדרש)
// =============================================================================
PIMPLE
{
    nOuterCorrectors    1;
    nCorrectors         2;
    nNonOrthogonalCorrectors 1;
}


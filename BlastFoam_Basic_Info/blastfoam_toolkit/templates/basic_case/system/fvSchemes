FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}

// =============================================================================
// BlastFOAM Basic Case Template - fvSchemes
// סכמות נומריות מומלצות לסימולציות פיצוץ
// =============================================================================

// סכמת flux - HLLC מומלץ לזרימות עם גלי הלם
fluxScheme      HLLC;
// אפשרויות נוספות: AUSM+, Kurganov, Tadmor

// =============================================================================
// סכמות נגזרת בזמן
// =============================================================================
ddtSchemes
{
    default         Euler;
    // לדיוק גבוה יותר: RK2SSP, RK3SSP
}

// =============================================================================
// סכמות גרדיאנט
// =============================================================================
gradSchemes
{
    default         cellLimited leastSquares 1;
    // cellLimited מונע oscillations ליד גלי הלם
}

// =============================================================================
// סכמות דיברגנס
// =============================================================================
divSchemes
{
    default         none;
    div(tauMC)      Gauss linear;
}

// =============================================================================
// סכמות לפלסיאן
// =============================================================================
laplacianSchemes
{
    default         Gauss linear corrected;
}

// =============================================================================
// סכמות אינטרפולציה - חשוב מאוד לדיוק!
// =============================================================================
interpolationSchemes
{
    default         linear;
    
    // MUSCL reconstruction לשדות עיקריים
    // vanLeer limiter מומלץ לאיזון בין דיוק ויציבות
    reconstruct(rho)            MUSCL vanLeer;
    reconstruct(U)              MUSCL vanLeer;
    reconstruct(e)              MUSCL vanLeer;
    reconstruct(p)              MUSCL vanLeer;
    reconstruct(speedOfSound)   MUSCL vanLeer;
    
    // אפשרויות limiters נוספות:
    // vanLeer     - איזון טוב (מומלץ)
    // minmod      - יותר דיפוזיבי, יותר יציב
    // superbee    - פחות דיפוזיבי, פחות יציב
    // vanAlbada   - דומה ל-vanLeer
}

// =============================================================================
// סכמות snGrad
// =============================================================================
snGradSchemes
{
    default         corrected;
}

// =============================================================================

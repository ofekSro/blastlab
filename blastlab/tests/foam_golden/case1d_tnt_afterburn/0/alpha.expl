FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.expl;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];
internalField   uniform 0;
boundaryField
{
    outlet
    {
        type            zeroGradient;
    }
    wedge
    {
        type            wedge;
    }
}


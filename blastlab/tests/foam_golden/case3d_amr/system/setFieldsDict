FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fields (alpha.expl);
nBufferLayers   1;
maxRefinement   3;
defaultFieldValues
(
    volScalarFieldValue alpha.expl 0
);
regions
(
    sphericalMassToCell
    {
        centre (1 1 1);
        rho             1630;
        mass            8;
        scale           1.013018756;
        backup
        {
            centre (1 1 1);
            radius          0.2108472398;
        }
        fieldValues
        (
            volScalarFieldValue alpha.expl    1
        );
    }
);


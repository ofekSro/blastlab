defaultFieldValues
(
    volScalarFieldValue alpha.expl 0
);
regions
(
    sphericalMassToCell
    {
        centre (0.5 0.5 0.5);
        rho             1601;
        mass            8;
        backup
        {
            centre (0.5 0.5 0.5);
            radius          0.2121127026;
        }
        fieldValues
        (
            volScalarFieldValue alpha.expl    1
        );
    }
);


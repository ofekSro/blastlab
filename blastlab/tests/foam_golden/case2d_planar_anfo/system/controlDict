FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     blastFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.1176012277;
deltaT          1e-7;
writeControl    adjustableRunTime;
writeInterval   0.0001103034708;
cycleWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable true;
adjustTimeStep  yes;
maxCo           0.4;
maxDeltaT       1;
OptimisationSwitches
{
    fileModificationChecking timeStampMaster;
    fileModificationSkew 1;
}

// ************************************************************************* //

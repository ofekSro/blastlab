FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      rho.expl;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -3 0 0 0 0 0];
internalField   uniform 1630;
boundaryField
{
    x_hi
    {
        type            zeroGradient;
    }
    y_lo
    {
        type            zeroGradient;
    }
    y_hi
    {
        type            zeroGradient;
    }
    wedge
    {
        type            wedge;
    }
}

